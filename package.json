{
  "name": "react-native-zerostyles",
  "version": "0.2.2",
  "description": "Typed theming for React Native with zero dependencies and selector-based subscriptions.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    }
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "changeset": "changeset",
    "lint": "pnpm --dir example/zerostyles-app lint",
    "format:check": "prettier --check .",
    "prepare": "pnpm build",
    "test": "vitest run",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "keywords": [
    "react-native",
    "theme",
    "theming",
    "dark-mode",
    "styles",
    "typescript",
    "expo"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/JoseRFelix/react-native-zerostyles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseRFelix/react-native-zerostyles.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.2.2",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.18",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
