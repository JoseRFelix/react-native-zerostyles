{
  "name": "react-native-zerostyles",
  "version": "0.1.0",
  "description": "Base setup for a React Native library.",
  "keywords": [
    "library",
    "react-native"
  ],
  "license": "MIT",
  "author": "",
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib"
  ],
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "lint": "pnpm --dir example/zerostyles-app lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "jsdom": "^27.0.1",
    "oxfmt": "^0.44.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.0",
    "react-native": "^0.84.0",
    "react-native-builder-bob": "^0.40.18",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "pnpm@10.28.2",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
