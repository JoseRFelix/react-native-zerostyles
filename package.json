{
  "name": "react-native-zerostyles",
  "version": "0.1.0",
  "description": "Base setup for a React Native library.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    }
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "react-native": "^0.84.0",
    "react-native-builder-bob": "^0.40.18",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
